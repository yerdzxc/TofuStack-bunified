PORT=5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379
SIGNING_SECRET=secret
PASETO_LOCAL_KEY_PASERK=k4.local.XXXXX_GENERATE_WITH_script_XXXXX
